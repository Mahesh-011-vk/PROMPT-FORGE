# ==============================================================================
# PROMPTFORGE AI - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure for your local/production environment.
# ==============================================================================

# Application Settings
APP_NAME="PromptForge AI"
APP_VERSION="0.1.0"
ENVIRONMENT="development" # development | staging | production | testing
DEBUG=true
DEMO_MODE=true # When true, enables offline mock LLM providers without API keys

# Security
SECRET_KEY=replace-with-a-secure-random-32-byte-hex-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server
HOST="0.0.0.0"
PORT=8000
API_V1_PREFIX="/api/v1"

# Database Connections
DATABASE_URL="sqlite+aiosqlite:///./promptforge.db"
# For production PostgreSQL with pgvector:
# DATABASE_URL="postgresql+asyncpg://promptforge:promptforge_pass@localhost:5432/promptforge_db"

# Redis Cache & Task Queue
REDIS_URL="redis://localhost:6379/0"
USE_IN_MEMORY_CACHE=true

# Vector Database (pgvector / memory)
VECTOR_DB_TYPE="memory" # memory | pgvector
VECTOR_DB_URL="postgresql://promptforge:promptforge_pass@localhost:5432/promptforge_db"
EMBEDDING_DIMENSION=768

# AI Model Provider API Keys (Leave blank to use Demo/Mock Mode)
DEFAULT_PROVIDER="mock" # mock | gemini | openai | anthropic | ollama
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL="http://localhost:11434"
